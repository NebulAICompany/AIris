# ============================================
# AIris Environment Variables
# ============================================
# Copy this file to .env and fill in your actual API keys and values
# Never commit the .env file to version control

# ============================================
# AI/ML API Keys
# ============================================

# OpenAI API Key (required for OpenAI models and embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (required for Claude models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Hugging Face API Key
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Cohere API Key
COHERE_API_KEY=your_cohere_api_key_here

# Qwen API Key
QWEN_API_KEY=your_qwen_api_key_here

# DeepSeek API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ============================================
# Azure Services
# ============================================

# Azure Language Service (Text Analytics)
AZURE_LANGUAGE_KEY=your_azure_language_key_here
AZURE_LANGUAGE_ENDPOINT=your_azure_language_endpoint_here

# Azure Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_azure_document_intelligence_key_here
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=your_azure_document_intelligence_endpoint_here

# ============================================
# Search and Research APIs
# ============================================

# Tavily API Key (for web search)
TAVILY_API_KEY=your_tavily_api_key_here

# Wolfram Alpha App ID
WOLFRAM_APP_ID=your_wolfram_app_id_here

# ============================================
# Financial Data APIs
# ============================================

# Marketstack API Key (for stock market data)
MARKETSTACK_API_KEY=your_marketstack_api_key_here
# Optional: Override base URL (default: https://api.marketstack.com/v2)
# MARKETSTACK_BASE_URL=https://api.marketstack.com/v2

# Marketstack EOD API Key (for end-of-day stock data)
MARKETSTACK_EOD_API_KEY=your_marketstack_eod_api_key_here

# Alpha Vantage API Key (for stock market data)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# TCMB (Turkish Central Bank) API Key
TCMB_API_KEY=your_tcmb_api_key_here

# Gold price APIs (optional; used by the desktop currency widget)
GOLDAPI_KEY=your_goldapi_key_here
METALPRICEAPI_KEY=your_metalpriceapi_key_here

# ============================================
# Sandbox
# ============================================

# E2B API Key (for E2B sandbox environments)
E2B_API_KEY=your_e2b_api_key_here

# ============================================
# LangSmith / LangChain tracing (optional)
# ============================================

LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=airis

# ============================================
# GLM Model Server (Optional)
# ============================================
# These are used by the GLM-4.5V vision language model server

# API Key for GLM server (required if you run backend/external/glm/start.py)
# API_KEY=your_glm_api_key_here

# Port for GLM server (default: "8080")
# PORT=8080

# Hugging Face model cache directory (default: "/tmp/model_cache")
# HF_HOME=/tmp/model_cache
