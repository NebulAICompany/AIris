# ============================================
# AIris Environment Variables
# ============================================
# Copy this file to .env and fill in your actual API keys and values
# Never commit the .env file to version control

# ============================================
# AI/ML API Keys
# ============================================

# OpenAI API Key (required at startup; used for models, moderation, and vision)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (required at startup; default coordinator and specialists)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Hugging Face API Key (not used by the standard runtime)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Cohere API Key (required at startup; embeddings and reranking)
COHERE_API_KEY=your_cohere_api_key_here

# Qwen API Key (required at startup because the client is eagerly constructed)
QWEN_API_KEY=your_qwen_api_key_here

# DeepSeek API Key (optional unless DeepSeek is selected in code)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ============================================
# Azure Services
# ============================================

# Azure Language Service (not used by the standard runtime)
AZURE_LANGUAGE_KEY=your_azure_language_key_here
AZURE_LANGUAGE_ENDPOINT=your_azure_language_endpoint_here

# Azure Document Intelligence (endpoint required at startup; key required for parsing)
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_azure_document_intelligence_key_here
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=your_azure_document_intelligence_endpoint_here

# ============================================
# Search and Research APIs
# ============================================

# Tavily API Key (required at startup; used for web search)
TAVILY_API_KEY=your_tavily_api_key_here

# Wolfram Alpha App ID
WOLFRAM_APP_ID=your_wolfram_app_id_here

# ============================================
# Financial Data APIs
# ============================================

# Marketstack API Key (for stock market data)
MARKETSTACK_API_KEY=your_marketstack_api_key_here
# Optional: Override base URL (default: https://api.marketstack.com/v2)
# MARKETSTACK_BASE_URL=https://api.marketstack.com/v2

# Alpha Vantage API Key (defined but not used by the standard runtime)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# TCMB (Turkish Central Bank) API Key
TCMB_API_KEY=your_tcmb_api_key_here

# Gold price APIs (optional; used by the desktop currency widget)
GOLDAPI_KEY=your_goldapi_key_here
METALPRICEAPI_KEY=your_metalpriceapi_key_here

# ============================================
# Sandbox
# ============================================

# E2B API Key (for E2B sandbox environments)
E2B_API_KEY=your_e2b_api_key_here

# ============================================
# LangSmith / LangChain tracing (optional)
# ============================================

LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=airis
